class Solution:
    def myAtoi(self, s: str) -> int:
        i = 0
        n = len(s)

        INT_MIN = -(2**31)
        INT_MAX = 2**31 - 1

        # 1. Skip leading spaces
        while i < n and s[i] == " ":
            i += 1

        # 2. Check the sign
        sign = 1

        if i < n and s[i] == "-":
            sign = -1
            i += 1
        elif i < n and s[i] == "+":
            i += 1

        # 3. Read digits
        num = 0

        while i < n and s[i].isdigit():
            digit = int(s[i])
            num = num * 10 + digit
            i += 1

        # 4. Apply the sign
        num *= sign

        # 5. Clamp to the 32-bit signed integer range
        if num < INT_MIN:
            return INT_MIN
        if num > INT_MAX:
            return INT_MAX

        return num
