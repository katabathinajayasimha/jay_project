class Solution:
    def findMedianSortedArrays(self, nums1, nums2):
        nums = sorted(nums1 + nums2)
        n = len(nums)

        if n % 2 == 1:
            return float(nums[n // 2])
        else:
            middle1 = nums[n // 2 - 1]
            middle2 = nums[n // 2]
            return (middle1 + middle2) / 2
